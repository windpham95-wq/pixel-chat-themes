{
  "name": "Mọt Sách",
  "short_name": "Mọt Sách",
  "description": "Ứng dụng đọc sách tiếng Việt dễ thương: EPUB, DOCX, TXT, chữ to rõ, nền dịu mắt, tô màu và ghi chú.",
  "lang": "vi",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8f3ea",
  "theme_color": "#f8f3ea",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/epub+zip": [".epub"], "text/plain": [".txt", ".md"] } }
  ]
}
